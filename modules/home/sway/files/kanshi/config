# kanshi — display profiles. Reload after editing with:
#   pkill kanshi; swaymsg exec kanshi
#
# Profiles are tried in order; the first one whose outputs all match the
# currently connected displays is applied. If none match, kanshi does
# nothing and sway's own output defaults apply.

# ── Dual external monitors (HDMI on top, DP below) ────────────────────
# HDMI above DP, centered horizontally. DP at native 4K.
profile dual-monitors {
    output HDMI-A-1 enable mode 1920x1080@60Hz position 960,0 scale 1.0
    output DP-1 enable mode 3840x2160@144Hz position 0,1080 scale 1.0
}

# ── Single HDMI monitor ───────────────────────────────────────────────
profile hdmi-only {
    output HDMI-A-1 enable mode 1920x1080@60Hz position 0,0 scale 1.0
}

# ── Single DP monitor ─────────────────────────────────────────────────
profile dp-only {
    output DP-1 enable mode 3840x2160@144Hz position 0,0 scale 1.0
}
